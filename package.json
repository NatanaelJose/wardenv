{
  "name": "wardenv",
  "version": "0.2.0",
  "description": "Keep your .env out of the AI context. Blocks secret reads, redacts leaked values in tool output, and logs every unlock. Hooks for coding agents.",
  "keywords": [
    "claude-code",
    "ai-agent",
    "dotenv",
    "env",
    "secrets",
    "security",
    "hooks",
    "redaction",
    "llm",
    "prompt-security"
  ],
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "wardenv": "src/cli.js"
  },
  "main": "src/lib/index.js",
  "files": [
    "src/",
    "hooks/",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/wardenv.test.js test/cli.test.js test/hooks.test.js test/adapters.test.js",
    "install-hooks": "node src/install.js",
    "uninstall-hooks": "node src/install.js --uninstall"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NatanaelJose/wardenv.git"
  },
  "dependencies": {},
  "homepage": "https://github.com/NatanaelJose/wardenv#readme",
  "bugs": {
    "url": "https://github.com/NatanaelJose/wardenv/issues"
  },
  "funding": {
    "type": "individual",
    "url": "https://www.buymeacoffee.com/natanaelisidoro"
  }
}
